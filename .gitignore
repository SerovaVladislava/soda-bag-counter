__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# рабочие данные: видео, история, архив кадров, логи
data/uploads/*
!data/uploads/.gitkeep
data/*.jpg

# локальные резервные копии проекта
backups/

# комплект для передачи: архив образов собирается заново, в историю не кладём,
# а конфигурация развёртывания и инструкция версионируются
artifacts/*.tar
artifacts/*.tar.gz
artifacts/data/
# подменяемый файл качается из backend/app, дубликат в истории не нужен
artifacts/hotfix/analytics.py

# локальные настройки инструментов разработчика
.claude/
